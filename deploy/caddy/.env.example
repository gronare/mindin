VAULT_HOST=vault.example.com
VAULT_PUBLIC_URL=https://vault.example.com

# Wraps every account's key; make one with: notes-vault-mcp master-key generate. Back it up: without it no vault can be read.
VAULT_HOSTED_MASTER_KEY=REPLACE_ME

# Each sign-in method is on when its settings are present; keep at least one.
VAULT_SMTP_HOST=smtp.example.com
VAULT_SMTP_USERNAME=REPLACE_ME
VAULT_SMTP_PASSWORD=REPLACE_ME
VAULT_SMTP_FROM=Vault <vault@example.com>
VAULT_GITHUB_CLIENT_ID=
VAULT_GITHUB_CLIENT_SECRET=
VAULT_OIDC_ISSUER=
VAULT_OIDC_CLIENT_ID=
VAULT_OIDC_CLIENT_SECRET=
VAULT_OIDC_NAME=

S3_ENDPOINT=https://s3.example.com
S3_BUCKET=vault
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_PREFIX=
S3_REGION=us-east-1

# A local folder instead of S3: drop the S3_* lines, set VAULT_PATH=/vault and bind-mount the folder there.
