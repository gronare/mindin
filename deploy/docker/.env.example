# notes-vault-mcp server settings. docs/reference/configuration.md describes every variable.

# ---- Required: edit these ----

# The domain the server answers on. Point it at this machine and open ports 80 and 443; Caddy fetches the certificate. The server's address is https://VAULT_HOST.
VAULT_HOST=vault.example.com

# Seals every vault. Make one with: docker compose run --rm --no-deps vault master-key generate
# Back it up outside this machine: without it no vault can be read.
VAULT_HOSTED_MASTER_KEY=

# At least one way to sign in. Email links are below; GitHub, an identity provider and a trusted proxy are further down.
VAULT_SMTP_HOST=smtp.example.com
VAULT_SMTP_FROM=Vault <vault@example.com>
VAULT_SMTP_USERNAME=REPLACE_ME
VAULT_SMTP_PASSWORD=REPLACE_ME
# VAULT_SMTP_SECURITY=starttls
# VAULT_SMTP_PORT=587

# ---- Storage ----

# The vaults live in the container's /data volume. To keep them in an S3 bucket instead, delete this line and fill in the S3 block.
VAULT_PATH=/data/vaults

# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=vault
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_PREFIX=

# ---- Optional: other ways to sign in ----

# GitHub: an OAuth app with the callback https://VAULT_HOST/signin/github/callback
# VAULT_GITHUB_CLIENT_ID=
# VAULT_GITHUB_CLIENT_SECRET=

# An OpenID Connect provider: a confidential client with the callback https://VAULT_HOST/oidc/callback
# VAULT_OIDC_ISSUER=
# VAULT_OIDC_CLIENT_ID=
# VAULT_OIDC_CLIENT_SECRET=
# VAULT_OIDC_NAME=your organisation
# VAULT_OIDC_SCOPES=openid email profile

# A proxy in front that signs in people and forwards a signed identity token
# VAULT_IDENTITY_PUBLIC_KEY=
# VAULT_IDENTITY_ISSUER=
# VAULT_IDENTITY_HEADER=X-Forwarded-Identity
# VAULT_IDENTITY_TYP=
# VAULT_IDENTITY_WRITE_CLAIMS=vault:write
# VAULT_IDENTITY_READ_CLAIMS=vault:read
# VAULT_IDENTITY_NAME=your company's sign-in

# ---- Optional: accounts and access ----

# VAULT_REGISTRATION=invite
# VAULT_PASSKEYS=on
# VAULT_ALLOWED_HOSTS=
# VAULT_SUBJECT_PREFIX=users

# ---- Optional: rotating the master key ----

# VAULT_HOSTED_MASTER_KEY_PREVIOUS=

# ---- Optional: importing a vault from another bucket ----

# IMPORT_S3_ACCESS_KEY=
# IMPORT_S3_SECRET_KEY=

# ---- Optional: search by meaning ----

# docs/install/semantic-search.md turns it on with a compose.override.yml; these tune it.
# VAULT_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# VAULT_EMBED_BATCH=16
# VAULT_EMBED_THREADS=
# VAULT_EMBED_MAX_TOKENS=256
